# OSINT Assistant — LOCAL ONLY
# No cloud LLM providers are configured by default.

OSINT_LLM_PROVIDERS=local

# Local OpenAI-compatible provider, e.g. Ollama, LM Studio, vLLM, llama.cpp server.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1
# Optional. Ollama usually ignores the bearer token, but some local gateways require one.
LOCAL_LLM_API_KEY=local-dev-key

# Local AIA governed verification/signal ingest.
AIA_BASE_URL=http://localhost:3001
AIA_API_KEY=
