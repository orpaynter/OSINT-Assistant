# OSINT Assistant — local LLM + internet/Tor + local AIA
OSINT_LLM_PROVIDERS=local

# Local OpenAI-compatible provider, e.g. Ollama, LM Studio, vLLM, llama.cpp server.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1
LOCAL_LLM_API_KEY=local-dev-key

# Internet and dark-web source access.
INTERNET_ENABLED=true
# Optional local SearXNG instance for clearnet search.
SEARXNG_URL=http://localhost:8080
# Tor must be installed/running locally for .onion access.
ALLOW_ONION=true
TOR_PROXY=socks5h://127.0.0.1:9050
OSINT_USER_AGENT=OSINT-Assistant/1.0 (+authorized research)

# Local AIA governed verification/signal ingest.
AIA_BASE_URL=http://localhost:3001
AIA_API_KEY=
