# OSINT Assistant — Privacy-First Local Configuration
# Copy to .env and adjust as needed.
# All defaults are privacy-preserving and local-only.

# ── LLM (local only) ────────────────────────────────────────────────────────
OSINT_LLM_PROVIDERS=local
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1
LOCAL_LLM_API_KEY=local-dev-key

# ── Privacy / routing ────────────────────────────────────────────────────────
# strict (default): all clearnet/onion traffic routes through Tor; fail-closed.
# direct: bypasses Tor — emits a visible warning. Only for isolated lab use.
PRIVACY_MODE=strict

# Tor SOCKS5 proxy (used in strict mode and for .onion access).
TOR_PROXY=socks5h://127.0.0.1:9050

# ── Source access ────────────────────────────────────────────────────────────
INTERNET_ENABLED=true

# Optional local SearXNG instance (loopback stays direct; remote is Tor-routed).
SEARXNG_URL=http://localhost:8080

# Set true only when Tor is running and you need dark-web sources.
ALLOW_ONION=false

# Generic browser user-agent; change to any non-identifying string.
OSINT_USER_AGENT=Mozilla/5.0 (compatible; local-research-tool/1.0)

# ── Flask server ─────────────────────────────────────────────────────────────
# Bind to loopback by default. Set to 0.0.0.0 ONLY on a trusted isolated network.
OSINT_BIND_HOST=127.0.0.1
OSINT_PORT=5000

# Debug mode is OFF by default. Enable only for development.
FLASK_DEBUG=false

# Comma-separated CORS origins to allow. Leave empty for same-origin only (default).
# Example: OSINT_CORS_ORIGINS=http://localhost:3000
OSINT_CORS_ORIGINS=

# ── Local AIA ────────────────────────────────────────────────────────────────
AIA_BASE_URL=http://localhost:3001
AIA_API_KEY=

# ── Endpoint safety ──────────────────────────────────────────────────────────
# Allow non-loopback LLM/AIA endpoints. Leave false unless you know what you're doing.
OSINT_ALLOW_REMOTE_ENDPOINTS=false

# ── Threat model (read before changing defaults) ─────────────────────────────
# • Local inference: LLM and AIA run on this machine; no data leaves locally.
# • Outbound source requests: fetching clearnet/onion URLs contacts remote servers.
#   In strict mode these go through Tor to reduce direct exposure.
# • Tor privacy: reduces direct source exposure; does NOT guarantee anonymity.
# • Direct mode: skips Tor entirely. Operator's IP is visible to source servers.
# • This software is for authorized, lawful public-source research ONLY.
