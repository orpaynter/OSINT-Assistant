# OSINT Assistant — Multi-LLM + AIA configuration
# Providers are tried in order and fail over when a key is missing or a provider errors.
# Supported: perplexity, openai, anthropic, google, groq, mistral, xai, deepseek,
# openrouter, together, fireworks, cohere, local
OSINT_LLM_PROVIDERS=perplexity,openai,anthropic,google,groq,mistral,xai,deepseek,openrouter,together,fireworks,cohere,local

# Optional global model/base URL overrides. Prefer provider-specific variables for normal use.
# OSINT_LLM_MODEL=
# OSINT_LLM_BASE_URL=

# Provider API keys. Fill only the providers you actually use. Never commit .env.
PERPLEXITY_API_KEY=your_perplexity_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
XAI_API_KEY=your_xai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Local OpenAI-compatible provider, e.g. Ollama/vLLM/LM Studio.
LOCAL_LLM_API_KEY=local-dev-key
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1

# AIA governed verification/signal ingest. Leave blank to run OSINT only.
# Example local AIA: http://localhost:3001
AIA_BASE_URL=
AIA_API_KEY=
